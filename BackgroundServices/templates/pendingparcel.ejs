<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shipment Confirmed</title>
</head>
<body style="margin:0;padding:24px;background:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e2e8f0;">
  <div style="max-width:620px;margin:0 auto;background:#1e293b;border-radius:16px;overflow:hidden;border:1px solid #334155;">
    <div style="background:#0f172a;padding:28px 32px;border-bottom:3px solid #f59e0b;">
      <span style="background:#f59e0b;color:#0f172a;font-weight:800;padding:4px 10px;border-radius:6px;font-size:12px;">SENDIT</span>
      <h1 style="margin:14px 0 4px;color:#ffffff;font-size:24px;">Shipment Confirmed</h1>
      <p style="margin:0;color:#fbbf24;font-family:monospace;font-size:15px;">Tracking ID: <%= trackingNumber %></p>
    </div>
    <div style="padding:28px 32px;">
      <p style="margin:0 0 18px;color:#cbd5e1;">Hello <strong><%= greetingName %></strong>, a parcel shipment has been registered on SendIT.</p>
      <table style="width:100%;border-collapse:collapse;background:#0f172a;border-radius:12px;overflow:hidden;">
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Route</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;font-weight:600;"><%= from %> &rarr; <%= to %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Sender</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;"><%= sendername %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Recipient</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;"><%= recipientname %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Service / Weight</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;text-transform:capitalize;"><%= serviceTier %> &bull; <%= weight %> kg</td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Estimated Delivery</td><td style="padding:10px 16px;color:#fbbf24;border-bottom:1px solid #1e293b;font-weight:600;"><%= estimatedDelivery %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;">Cost &amp; Note</td><td style="padding:10px 16px;color:#f8fafc;">$<%= cost %> &bull; <%= note %></td></tr>
      </table>
      <div style="text-align:center;margin:28px 0 8px;">
        <a href="<%= trackUrl %>" style="display:inline-block;background:#f59e0b;color:#0f172a;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:10px;">Track Your Parcel Live</a>
      </div>
    </div>
    <div style="background:#0f172a;padding:16px 32px;text-align:center;font-size:12px;color:#64748b;">
      SendIT Logistics &bull; Questions? <a href="mailto:support@sendit.io" style="color:#fbbf24;text-decoration:none;">support@sendit.io</a>
    </div>
  </div>
</body>
</html>
