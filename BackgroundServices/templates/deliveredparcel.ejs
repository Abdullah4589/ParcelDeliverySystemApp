<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Parcel Delivered</title>
</head>
<body style="margin:0;padding:24px;background:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e2e8f0;">
  <div style="max-width:620px;margin:0 auto;background:#1e293b;border-radius:16px;overflow:hidden;border:1px solid #334155;">
    <div style="background:#0f172a;padding:28px 32px;border-bottom:3px solid #10b981;">
      <span style="background:#10b981;color:#052e16;font-weight:800;padding:4px 10px;border-radius:6px;font-size:12px;">DELIVERED</span>
      <h1 style="margin:14px 0 4px;color:#ffffff;font-size:24px;">Your Parcel Has Arrived!</h1>
      <p style="margin:0;color:#34d399;font-family:monospace;font-size:15px;">Tracking ID: <%= trackingNumber %></p>
    </div>
    <div style="padding:28px 32px;">
      <p style="margin:0 0 18px;color:#cbd5e1;">Hello <strong><%= greetingName %></strong>, your shipment has been successfully delivered.</p>
      <table style="width:100%;border-collapse:collapse;background:#0f172a;border-radius:12px;overflow:hidden;">
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Route</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;font-weight:600;"><%= from %> &rarr; <%= to %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Sender</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;"><%= sendername %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;border-bottom:1px solid #1e293b;">Recipient</td><td style="padding:10px 16px;color:#f8fafc;border-bottom:1px solid #1e293b;"><%= recipientname %></td></tr>
        <tr><td style="padding:10px 16px;color:#94a3b8;">Weight &amp; Cost</td><td style="padding:10px 16px;color:#f8fafc;"><%= weight %> kg &bull; $<%= cost %></td></tr>
      </table>
      <div style="text-align:center;margin:28px 0 8px;">
        <a href="<%= trackUrl %>" style="display:inline-block;background:#10b981;color:#052e16;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:10px;">View Delivery Proof &amp; Rate</a>
      </div>
    </div>
    <div style="background:#0f172a;padding:16px 32px;text-align:center;font-size:12px;color:#64748b;">
      SendIT Logistics &bull; Questions? <a href="mailto:support@sendit.io" style="color:#fbbf24;text-decoration:none;">support@sendit.io</a>
    </div>
  </div>
</body>
</html>
