<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to SendIT</title>
</head>
<body style="margin:0;padding:24px;background:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e2e8f0;">
  <div style="max-width:620px;margin:0 auto;background:#1e293b;border-radius:16px;overflow:hidden;border:1px solid #334155;">
    <div style="background:linear-gradient(135deg,#0f172a,#1e293b);padding:32px;border-bottom:3px solid #f59e0b;text-align:center;">
      <div style="display:inline-block;background:#f59e0b;color:#0f172a;font-weight:800;padding:6px 14px;border-radius:8px;font-size:14px;letter-spacing:1px;">SENDIT LOGISTICS</div>
      <h1 style="margin:16px 0 0;color:#ffffff;font-size:26px;">Welcome aboard, <%= fullname %>!</h1>
    </div>
    <div style="padding:32px;">
      <p style="margin:0 0 16px;color:#cbd5e1;line-height:1.6;">Your SendIT account is ready. You can now book shipments, track parcels in real time, manage saved addresses, and download statements.</p>
      <div style="background:#0f172a;border:1px solid #334155;border-radius:12px;padding:20px;margin:24px 0;">
        <p style="margin:0 0 8px;font-size:13px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.8px;">Account Credentials</p>
        <p style="margin:6px 0;color:#f8fafc;"><strong>Email:</strong> <%= email %></p>
        <p style="margin:6px 0;color:#f8fafc;"><strong>Password:</strong> <code style="background:#1e293b;padding:2px 8px;border-radius:4px;color:#fbbf24;"><%= password %></code></p>
      </div>
      <div style="text-align:center;margin:28px 0;">
        <a href="<%= loginUrl %>" style="display:inline-block;background:#f59e0b;color:#0f172a;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:10px;">Sign In to Dashboard</a>
      </div>
      <p style="font-size:13px;color:#94a3b8;margin:0;">For security, keep your credentials private and consider updating your password after signing in.</p>
    </div>
    <div style="background:#0f172a;padding:18px 32px;text-align:center;font-size:12px;color:#64748b;">
      SendIT Logistics &bull; Need help? Contact <a href="mailto:support@sendit.io" style="color:#fbbf24;text-decoration:none;">support@sendit.io</a>
    </div>
  </div>
</body>
</html>
